# GeoTrust AI — MCP Server Configuration

# NitroStack Server
NITRO_LOG_LEVEL=info
NITROSTACK_APP_MODE=universal

# ─── NVIDIA NIM (required for Chef script) ───────────────────────────────────
# Get your free API key at: https://build.nvidia.com
# Model used: meta/llama-3.3-70b-instruct (supports tool calling)
NVIDIA_API_KEY=nvapi-your_key_here

# Optional: override the NIM model
# NIM_MODEL=meta/llama-3.3-70b-instruct

# ─── Server Transport (optional) ─────────────────────────────────────────────
# MCP_TRANSPORT_TYPE: stdio | http | dual
# Defaults to 'stdio' in dev, 'dual' in production
# MCP_TRANSPORT_TYPE=stdio
# PORT=3000
# HOST=localhost
# ENABLE_CORS=true
